# audit-code thresholds. Sourced by scripts/audit-sweeps.sh; bash syntax.
# Reviewer agents run above either number (code files only: tests, stories,
# .d.ts and docs never count). The verifier always runs.
AUDIT_REVIEWER_FILES=8
AUDIT_REVIEWER_LINES=300
# codebase mode (on main, or --scope): above this many files the run is split
# into balanced chunks that keep folders together; structure and types-and-state
# run once per chunk, styling-and-i18n once over the UI files, one verifier.
AUDIT_CODEBASE_MAX_FILES=60
# What counts as code, what counts as UI, what is excluded. Extended regex.
AUDIT_CODE_EXT='ts|tsx|js|jsx|mjs|cjs|vue|svelte'
AUDIT_UI_EXT='tsx|jsx|vue|svelte'
AUDIT_EXCLUDE='(/__[A-Za-z]+__/|^__[A-Za-z]+__/|\.(test|test-d|spec|stories|d)\.|/node_modules/|/dist/|/build/)'
